using System;
using System.Collections.Generic;
using System.Text.Json;
using FlashcardApp.Core.Interfaces;
using FlashcardApp.Core.Models;
using Npgsql;

namespace FlashcardApp.Core.Repositories
{
    /// <summary>
    /// A PostgreSQL-backed repository for storing users and their flashcard decks.
    /// </summary>
    public class PostgresUserRepository : IUserRepository
    {
        private readonly string _connectionString;

        /// <summary>
        /// Initializes a new instance of the <see cref="PostgresUserRepository"/> class.
        /// </summary>
        /// <param name="connectionString">The PostgreSQL connection string.</param>
        public PostgresUserRepository(string connectionString)
        {
            _connectionString = connectionString ?? throw new ArgumentNullException(nameof(connectionString));
            EnsureTableExists();
        }

        /// <summary>
        /// Ensures the Users table exists in the database.
        /// </summary>
        private void EnsureTableExists()
        {
            using var conn = new NpgsqlConnection(_connectionString);
            conn.Open();
            using var cmd = new NpgsqlCommand(@"
                CREATE TABLE IF NOT EXISTS Users (
                    Id UUID PRIMARY KEY,
                    Username VARCHAR(255) UNIQUE NOT NULL,
                    TotalXp INT NOT NULL,
                    DailyLimit INT NOT NULL,
                    DesiredRetention DOUBLE PRECISION NOT NULL,
                    Deck JSONB NOT NULL
                )", conn);
            cmd.ExecuteNonQuery();
        }

        public User? GetUserById(Guid id)
        {
            using var conn = new NpgsqlConnection(_connectionString);
            conn.Open();
            using var cmd = new NpgsqlCommand("SELECT Id, Username, TotalXp, DailyLimit, DesiredRetention, Deck FROM Users WHERE Id = @Id", conn);
            cmd.Parameters.AddWithValue("Id", id);

            using var reader = cmd.ExecuteReader();
            if (reader.Read())
            {
                return MapUser(reader);
            }
            return null;
        }

        public User? GetUserByUsername(string username)
        {
            using var conn = new NpgsqlConnection(_connectionString);
            conn.Open();
            using var cmd = new NpgsqlCommand("SELECT Id, Username, TotalXp, DailyLimit, DesiredRetention, Deck FROM Users WHERE Username = @Username", conn);
            cmd.Parameters.AddWithValue("Username", username);

            using var reader = cmd.ExecuteReader();
            if (reader.Read())
            {
                return MapUser(reader);
            }
            return null;
        }

        public void SaveUser(User user)
        {
            if (user == null) throw new ArgumentNullException(nameof(user));

            using var conn = new NpgsqlConnection(_connectionString);
            conn.Open();
            using var cmd = new NpgsqlCommand(@"
                INSERT INTO Users (Id, Username, TotalXp, DailyLimit, DesiredRetention, Deck)
                VALUES (@Id, @Username, @TotalXp, @DailyLimit, @DesiredRetention, @Deck::jsonb)
                ON CONFLICT (Id) DO UPDATE 
                SET Username = @Username,
                    TotalXp = @TotalXp,
                    DailyLimit = @DailyLimit,
                    DesiredRetention = @DesiredRetention,
                    Deck = @Deck::jsonb;", conn);

            cmd.Parameters.AddWithValue("Id", user.Id);
            cmd.Parameters.AddWithValue("Username", user.Username);
            cmd.Parameters.AddWithValue("TotalXp", user.TotalXp);
            cmd.Parameters.AddWithValue("DailyLimit", user.DailyLimit);
            cmd.Parameters.AddWithValue("DesiredRetention", user.DesiredRetention);
            
            // Serialize the deck to JSON to store in the JSONB column
            var deckJson = JsonSerializer.Serialize(user.Deck);
            cmd.Parameters.AddWithValue("Deck", deckJson);

            cmd.ExecuteNonQuery();
        }

        private User MapUser(NpgsqlDataReader reader)
        {
            var deckJson = reader.GetString(5);
            var deck = JsonSerializer.Deserialize<List<Flashcard>>(deckJson) ?? new List<Flashcard>();

            return new User
            {
                Id = reader.GetGuid(0),
                Username = reader.GetString(1),
                TotalXp = reader.GetInt32(2),
                DailyLimit = reader.GetInt32(3),
                DesiredRetention = reader.GetDouble(4),
                Deck = deck
            };
        }
    }
}
# Copy to .env; replace password values before using Docker Compose.
POSTGRES_DB=flashcardapp
POSTGRES_USER=flashcardapp
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DB_PORT=5432
API_PORT=8080
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=flashcardapp;Username=flashcardapp;Password=REPLACE_WITH_LOCAL_PASSWORD

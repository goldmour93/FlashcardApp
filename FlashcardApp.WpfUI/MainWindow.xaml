<Window x:Class="FlashcardApp.WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spaced Repetition Flashcards" Height="560" Width="760" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Stats -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource App.BrushSurface}"
                    BorderBrush="{StaticResource App.BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource App.CornerRadiusSmall}"
                    Padding="12,8"
                    Margin="0,0,8,0">
                <TextBlock x:Name="CardsReviewedText" Text="Cards Reviewed: 0" FontSize="16" FontWeight="SemiBold" />
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource App.BrushSurface}"
                    BorderBrush="{StaticResource App.BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource App.CornerRadiusSmall}"
                    Padding="12,8"
                    Margin="8,0,0,0">
                <TextBlock x:Name="XpGainedText" Text="Session XP: 0 | Total XP: 0" FontSize="16" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- Flashcard Area -->
        <Border Grid.Row="1"
                Background="{StaticResource App.BrushSurface}"
                CornerRadius="{StaticResource App.CornerRadiusMedium}"
                Padding="28"
                Margin="0,0,0,20"
                Effect="{StaticResource App.ShadowLow}"
                BorderBrush="{StaticResource App.BrushBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FrontText" Grid.Row="0" Text="Question goes here..." FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="640" />

                <Separator Grid.Row="1" Margin="0,14" Background="{StaticResource App.BrushBorder}"/>

                <TextBlock x:Name="BackText" Grid.Row="2" Text="Answer goes here..." FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Visibility="Hidden" Foreground="{StaticResource App.BrushTextMuted}" MaxWidth="640"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="2" Margin="0,6,0,2">
            <Button x:Name="ShowAnswerButton"
                    Content="Show Answer"
                    FontSize="17"
                    Width="260"
                    MinHeight="52"
                    HorizontalAlignment="Center"
                    Click="ShowAnswerButton_Click"
                    Style="{StaticResource Button.Primary}" />

            <WrapPanel x:Name="RatingPanel" HorizontalAlignment="Center" Visibility="Hidden" Margin="0,8,0,0">
                <Button Content="Again (1)" Tag="1" Margin="6" Click="RatingButton_Click" Style="{StaticResource Button.Danger}" />
                <Button Content="Hard (2)" Tag="2" Margin="6" Click="RatingButton_Click" Style="{StaticResource Button.Warning}" />
                <Button Content="Good (3)" Tag="3" Margin="6" Click="RatingButton_Click" Style="{StaticResource Button.Success}" />
                <Button Content="Easy (4)" Tag="4" Margin="6" Click="RatingButton_Click" Style="{StaticResource Button.Info}" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="FlashcardApp.WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spaced Repetition Flashcards" Height="450" Width="600" Background="#F0F0F0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Stats -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock x:Name="CardsReviewedText" Text="Cards Reviewed: 0" FontSize="16" FontWeight="Bold" Foreground="#333"/>
            <TextBlock x:Name="XpGainedText" Text="XP Gained: 0" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Flashcard Area -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock x:Name="FrontText" Grid.Row="0" Text="Question goes here..." FontSize="24" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                
                <Separator Grid.Row="1" Margin="0,10" Background="#EEE"/>
                
                <TextBlock x:Name="BackText" Grid.Row="2" Text="Answer goes here..." FontSize="20" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Hidden" Foreground="#555"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="2">
            <Button x:Name="ShowAnswerButton" Content="Show Answer" FontSize="18" Padding="10" Click="ShowAnswerButton_Click" Background="#0078D7" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            
            <StackPanel x:Name="RatingPanel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Hidden">
                <Button Content="Again (1)" Tag="1" Width="100" Margin="5" Padding="10" FontSize="16" Background="#D13438" Foreground="White" BorderThickness="0" Click="RatingButton_Click" Cursor="Hand"/>
                <Button Content="Hard (2)" Tag="2" Width="100" Margin="5" Padding="10" FontSize="16" Background="#FF8C00" Foreground="White" BorderThickness="0" Click="RatingButton_Click" Cursor="Hand"/>
                <Button Content="Good (3)" Tag="3" Width="100" Margin="5" Padding="10" FontSize="16" Background="#107C10" Foreground="White" BorderThickness="0" Click="RatingButton_Click" Cursor="Hand"/>
                <Button Content="Easy (4)" Tag="4" Width="100" Margin="5" Padding="10" FontSize="16" Background="#00B7C3" Foreground="White" BorderThickness="0" Click="RatingButton_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

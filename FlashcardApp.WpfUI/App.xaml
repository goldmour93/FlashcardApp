<Application x:Class="FlashcardApp.WpfUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>

        <!-- Palette -->
        <Color x:Key="App.ColorBg">#FFF5F6F8</Color>
        <Color x:Key="App.ColorSurface">#FFFFFFFF</Color>
        <Color x:Key="App.ColorPrimary">#FF2563EB</Color>
        <Color x:Key="App.ColorPrimaryHover">#FF1D4ED8</Color>
        <Color x:Key="App.ColorBorder">#FFE5E7EB</Color>
        <Color x:Key="App.ColorText">#FF0F172A</Color>
        <Color x:Key="App.ColorTextMuted">#FF64748B</Color>
        <Color x:Key="App.ColorDanger">#FFDC2626</Color>
        <Color x:Key="App.ColorWarning">#FFD97706</Color>
        <Color x:Key="App.ColorSuccess">#FF16A34A</Color>
        <Color x:Key="App.ColorInfo">#FF0284C7</Color>
        <Color x:Key="App.ColorFocus">#FF1D4ED8</Color>

        <SolidColorBrush x:Key="App.BrushBg" Color="{StaticResource App.ColorBg}" />
        <SolidColorBrush x:Key="App.BrushSurface" Color="{StaticResource App.ColorSurface}" />
        <SolidColorBrush x:Key="App.BrushPrimary" Color="{StaticResource App.ColorPrimary}" />
        <SolidColorBrush x:Key="App.BrushPrimaryHover" Color="{StaticResource App.ColorPrimaryHover}" />
        <SolidColorBrush x:Key="App.BrushBorder" Color="{StaticResource App.ColorBorder}" />
        <SolidColorBrush x:Key="App.BrushText" Color="{StaticResource App.ColorText}" />
        <SolidColorBrush x:Key="App.BrushTextMuted" Color="{StaticResource App.ColorTextMuted}" />
        <SolidColorBrush x:Key="App.BrushDanger" Color="{StaticResource App.ColorDanger}" />
        <SolidColorBrush x:Key="App.BrushWarning" Color="{StaticResource App.ColorWarning}" />
        <SolidColorBrush x:Key="App.BrushSuccess" Color="{StaticResource App.ColorSuccess}" />
        <SolidColorBrush x:Key="App.BrushInfo" Color="{StaticResource App.ColorInfo}" />
        <SolidColorBrush x:Key="App.BrushFocus" Color="{StaticResource App.ColorFocus}" />

        <!-- Layout tokens -->
        <CornerRadius x:Key="App.CornerRadiusSmall">8</CornerRadius>
        <CornerRadius x:Key="App.CornerRadiusMedium">14</CornerRadius>
        <Thickness x:Key="App.ControlPadding">12,8</Thickness>
        <Thickness x:Key="App.RatingPadding">16,12</Thickness>
        <sys:Double x:Key="App.ControlMinHeight">44</sys:Double>
        <sys:Double x:Key="App.RatingMinHeight">56</sys:Double>
        <sys:Double x:Key="App.RatingMinWidth">138</sys:Double>

        <!-- Effects -->
        <DropShadowEffect x:Key="App.ShadowLow" Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.12" />

        <!-- Window defaults -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource App.BrushBg}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource App.BrushText}" />
        </Style>

        <!-- Text defaults -->
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource App.BrushSurface}" />
            <Setter Property="Foreground" Value="{StaticResource App.BrushText}" />
            <Setter Property="BorderBrush" Value="{StaticResource App.BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{StaticResource App.ControlPadding}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="{StaticResource App.ControlMinHeight}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource App.CornerRadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource App.BrushFocus}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource App.BrushPrimary}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource App.BrushPrimaryHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Button.RatingBase" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="{StaticResource App.RatingMinHeight}" />
            <Setter Property="MinWidth" Value="{StaticResource App.RatingMinWidth}" />
            <Setter Property="Padding" Value="{StaticResource App.RatingPadding}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.RatingBase}">
            <Setter Property="Background" Value="{StaticResource App.BrushDanger}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="Button.Warning" TargetType="Button" BasedOn="{StaticResource Button.RatingBase}">
            <Setter Property="Background" Value="{StaticResource App.BrushWarning}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="Button.Success" TargetType="Button" BasedOn="{StaticResource Button.RatingBase}">
            <Setter Property="Background" Value="{StaticResource App.BrushSuccess}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="Button.Info" TargetType="Button" BasedOn="{StaticResource Button.RatingBase}">
            <Setter Property="Background" Value="{StaticResource App.BrushInfo}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="{StaticResource App.ControlPadding}" />
            <Setter Property="BorderBrush" Value="{StaticResource App.BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource App.BrushSurface}" />
            <Setter Property="MinHeight" Value="{StaticResource App.ControlMinHeight}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource App.CornerRadiusSmall}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource App.BrushPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="{StaticResource App.ControlPadding}" />
            <Setter Property="BorderBrush" Value="{StaticResource App.BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource App.BrushSurface}" />
            <Setter Property="MinHeight" Value="{StaticResource App.ControlMinHeight}" />
        </Style>

    </Application.Resources>
</Application>

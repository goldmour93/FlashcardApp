<Window x:Class="FlashcardApp.WpfUI.TopicSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose topic" Height="420" Width="620" WindowStartupLocation="CenterScreen" MinHeight="420" MinWidth="620">

    <Grid Margin="24">
        <Border Background="{StaticResource App.BrushSurface}"
                CornerRadius="{StaticResource App.CornerRadiusMedium}"
                Padding="30"
                Effect="{StaticResource App.ShadowLow}"
                BorderBrush="{StaticResource App.BrushBorder}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520">
            <StackPanel>
                <TextBlock Text="Pick a topic" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="Choose what to focus on for this session." Foreground="{StaticResource App.BrushTextMuted}" Margin="0,0,0,18" />

                <TextBlock Text="Topic" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="TopicComboBox" Margin="0,0,0,16" />

                <Button x:Name="StartButton"
                        Content="Start session"
                        Click="StartButton_Click"
                        Height="46"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
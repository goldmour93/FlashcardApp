<Window x:Class="FlashcardApp.WpfUI.TopicSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Topic" Height="200" Width="300" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Select a Topic to Study:" Margin="0,0,0,10" FontWeight="Bold" />
        <ComboBox x:Name="TopicComboBox" Margin="0,0,0,20" Padding="5" />
        <Button x:Name="StartButton" Content="Start Session" Click="StartButton_Click" Padding="5" />
    </StackPanel>
</Window>